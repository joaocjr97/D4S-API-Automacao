# =============================================================================
# AMBIENTE D4Sign API
# Valor ENVIRONMENT -> URL base da API (/api/v1)
# =============================================================================
# prod    -> https://secure.d4sign.com.br/api/v1
# ghost   -> https://ghost.d4sign.com.br/api/v1
# homol   -> https://homol.d4sign.com.br/api/v1
# staging -> https://stage.d4sign.com.br/api/v1
# hotfix  -> https://hotfix.d4sign.com.br/api/v1
ENVIRONMENT=homol

# =============================================================================
# CREDENCIAIS
# =============================================================================
D4S_USERNAME=seu_email@exemplo.com
D4S_PASSWORD=sua_senha
TOKEN_API=sua_token_api
CRYPT_KEY=sua_crypt_key
EMAIL_TESTE=email_para_testes@exemplo.com
EMAIL_ALTERADO=signatario.alterado@teste.com
WHATSAPP_TESTE=5511954976905

# =============================================================================
# UUIDs / IDs DE AMBIENTE
# =============================================================================
UUID_SAFE=
LIST_ESPECIFIC_DOCUMENT=
UUID_PINS=
UUID_WEBHOOK_DOCUMENT=
UUID_DOC_WEBHOOK=
URL_WEBHOOK=https://superteste.requestcatcher.com
DOCUMENTS_PHASE=3

TEMPLATE_ID_WORD=
TEMPLATE_NAME_WORD=Template Word de Testes QA.docx
TEMPLATE_ID_HTML=
TEMPLATE_NAME_HTML=Relatório de QA - Temp HTML

# Pins
PAGE_WIDTH=794
PAGE_HEIGHT=1123
PAGE=1
POS_X_0=100
POS_Y_0=150
TYPE_0=0
POS_X_1=397
POS_Y_1=300
TYPE_1=1
POS_X_2=600
POS_Y_2=500
TYPE_2=2

EXPECTED_PIN_EMAIL=joao.carlos@d4sign.com.br
EXPECTED_PIN_POSITION_X=600
EXPECTED_PIN_PAGE_HEIGHT=1123.00

# =============================================================================
# HTTP
# =============================================================================
HTTP_TIMEOUT=30
HTTP_MAX_RETRIES=3
LOG_LEVEL=INFO
